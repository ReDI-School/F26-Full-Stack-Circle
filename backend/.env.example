# Database
#
# These are the same variable names used in preview and production, where
# they are filled in by the Supabase integration. Locally they both point
# at the PostgreSQL container from docker-compose.yml (`pnpm db:up`).
#
# POSTGRES_PRISMA_URL     -- pooled connection, used for queries at runtime
# POSTGRES_URL_NON_POOLING -- direct connection, used for migrations
POSTGRES_PRISMA_URL="postgres://redi:redi@localhost:5434/redicycle"
POSTGRES_URL_NON_POOLING="postgres://redi:redi@localhost:5434/redicycle"

# Server Configuration
NODE_ENV="development"
PORT="4000"
HOST="localhost"
PROTOCOL="http"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"


# Authentication
#
# The secret the login token is signed with. Anyone who knows it can mint a
# token for any account, so it is never committed -- put something long and
# random in your own .env (`openssl rand -base64 32` is one way).
# The server refuses to start without it.
JWT_SECRET="change-me-to-a-long-random-string"