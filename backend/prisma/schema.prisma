// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// From Prisma 7 on, the connection URL lives in prisma.config.ts
// instead of here.
datasource db {
  provider = "postgresql"
}

/// How worn an item is. Shown by the ConditionBadge on every card.
/// Prisma enum values cannot contain a hyphen, so the API maps
/// LIKE_NEW to the 'like-new' the frontend expects.
enum Condition {
  NEW
  LIKE_NEW
  GOOD
  USED
}

/// One account. Registering creates the matching Shop, which is why
/// the relation is optional here but unique on the other side.
model User {
  id           String      @id @default(uuid())
  email        String   @unique
  /// A bcrypt hash, never the password itself. Nothing outside the
  /// auth code should read this column, and no API response should
  /// ever carry it.
  passwordHash String
  name         String
  avatarUrl    String?
  /// Admins reach /admin and curate the homepage rows.
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shop             Shop?
  /// User has two separate relations to Thread, so both need a name.
  threadsAsBuyer   Thread[]  @relation("ThreadBuyer")
  threadsAsSeller  Thread[]  @relation("ThreadSeller")
  messages         Message[]
}

/// A person's shop. One per account, enforced by the unique ownerId.
model Shop {
  id      String     @id @default(uuid())
  name    String
  /// "Sells & ships from Berlin" - shown under the shop name.
  subline String?
  ownerId String     @unique
  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  items Item[]
}

/// A browsable category. This is a table and not an enum because
/// CategoryTile needs an emoji and a tint per category.
model Category {
  id    String    @id @default(uuid())
  slug  String @unique
  name  String
  emoji String
  /// 0 | 1 | 2 - which of the three pastel tints the tile uses.
  tint  Int

  items Item[]
}

/// One thing for sale.
model Item {
  id          String    @id @default(uuid())
  title       String
  description String

  /// Money is stored in whole cents, never as a float: 0.1 + 0.2 is
  /// not 0.3 in binary floating point. EUR 18.00 is 1800 here, and
  /// the frontend divides by 100. 0 is allowed - the add-item form
  /// says "0 = give away".
  priceCents    Int
  /// The price before the seller discounted it, or null. The item
  /// detail page shows it struck through.
  oldPriceCents Int?

  condition Condition
  sold      Boolean   @default(false)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  shopId String
  shop   Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos   ItemPhoto[]
  threads  Thread[]
  homeRows HomeRowItem[]

  /// Browse filters by category and by sold, and every shop page
  /// lists one shop's items.
  @@index([categoryId])
  @@index([shopId])
  @@index([sold])
}

/// A photo of an item. The add-item form offers three slots and the
/// detail page shows a main photo plus thumbnails, so photos are
/// their own ordered table rather than a column on Item.
model ItemPhoto {
  id       String    @id @default(uuid())
  url      String
  /// 0 is the main photo shown on the card and at the top of the
  /// detail page.
  position Int

  itemId String
  item   Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, position])
  @@index([itemId])
}

/// One conversation about one item, started when a buyer taps
/// "I'm interested".
model Thread {
  id String @id @default(uuid())

  itemId String
  item   Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  buyerId String
  buyer   User @relation("ThreadBuyer", fields: [buyerId], references: [id], onDelete: Cascade)

  sellerId String
  seller   User @relation("ThreadSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  /// Bumped on every new message so the inbox can sort by most
  /// recent without counting messages.
  updatedAt DateTime @updatedAt

  messages Message[]

  /// A buyer asking twice about the same item lands in the existing
  /// conversation, not a second one.
  @@unique([itemId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
}

/// One message inside a thread.
model Message {
  id String @id @default(uuid())

  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  senderId String
  sender   User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  body String
  /// null means unread - that is the orange dot in the inbox list.
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

/// One curated row on the homepage. The contents are picked by an
/// admin, not computed from a query.
model HomeRow {
  id       String    @id @default(uuid())
  /// "fresh" | "cheap" | "deals" | "tech"
  key      String @unique
  /// "fresh finds ✨"
  title    String
  position Int

  items HomeRowItem[]
}

/// One slot in a curated row. Prisma needs a primary key, so this
/// join table carries its own id alongside the unique pair.
model HomeRowItem {
  id       String @id @default(uuid())
  position Int

  homeRowId String
  homeRow   HomeRow @relation(fields: [homeRowId], references: [id], onDelete: Cascade)

  itemId String
  item   Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([homeRowId, itemId])
  @@index([itemId])
}
